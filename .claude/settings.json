{
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit|NotebookEdit",
        "hooks": [
          {
            "type": "command",
            "command": "make -s -C \"$CLAUDE_PROJECT_DIR\" uninstall-app >&2; \"$CLAUDE_PROJECT_DIR\"/scripts/dist.sh --hook",
            "timeout": 300
          }
        ]
      }
    ]
  }
}
