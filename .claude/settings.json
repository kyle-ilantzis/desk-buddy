{
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit|NotebookEdit",
        "hooks": [
          {
            "type": "command",
            "command": "make -s -C \"$CLAUDE_PROJECT_DIR\" dist-hook",
            "timeout": 300
          }
        ]
      }
    ]
  }
}
